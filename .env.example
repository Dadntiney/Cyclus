# Supabase project settings — public, safe to expose client-side
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret for a future AI provider integration for the Buddy.
# Never prefix this with NEXT_PUBLIC_ and never reference it from client components.
BUDDY_AI_API_KEY=

# Temporary test-phase switch (see src/lib/actions/auth.ts). When "true",
# auth flows skip sending real Supabase emails. Requires "Confirm email"
# to also be turned off in Supabase → Authentication → Providers → Email
# for registration to work without email. Set to "false" (or remove) for
# production so real confirmation/reset emails go out again.
AUTH_TEST_MODE=false

# Server-only secrets used to fetch + cache recipe photos (see
# src/lib/images/*). Never prefix with NEXT_PUBLIC_. OPENAI_API_KEY (paid,
# AI-generated, most consistent) is preferred when set; otherwise
# PEXELS_API_KEY (free stock photos) is used.
OPENAI_API_KEY=
PEXELS_API_KEY=

# Server-only Supabase secret (Project Settings -> API -> service_role).
# Bypasses Row Level Security — only used server-side to write recipe
# images to Storage/DB, which regular user sessions are not allowed to
# do. Never prefix with NEXT_PUBLIC_, never expose to client code.
SUPABASE_SERVICE_ROLE_KEY=

# Real web push (see src/lib/push/*, src/app/api/cron/send-reminders).
# Generate a keypair once with `npx web-push generate-vapid-keys` and never
# rotate it casually — every existing browser subscription is tied to this
# exact public key and would silently stop working if it changed.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is safe client-side (that's its purpose);
# VAPID_PRIVATE_KEY must stay server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact shown to push services (Apple/Google/Mozilla) if they need to
# reach the app owner about abuse — a generic project address is fine, it
# does not need to be a real inbox for push to function.
VAPID_SUBJECT=mailto:support@cyclus.app

# Random secret shared with Vercel Cron (see vercel.json) so the
# /api/cron/send-reminders route only runs for Vercel's own scheduler, never
# for a public request. Vercel sets this automatically for Cron-triggered
# requests when the env var of the same name exists on the project.
CRON_SECRET=
