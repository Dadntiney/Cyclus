# Supabase project settings — public, safe to expose client-side
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret for a future AI provider integration for the Buddy.
# Never prefix this with NEXT_PUBLIC_ and never reference it from client components.
BUDDY_AI_API_KEY=

# Temporary test-phase switch (see src/lib/actions/auth.ts). When "true",
# auth flows skip sending real Supabase emails. Requires "Confirm email"
# to also be turned off in Supabase → Authentication → Providers → Email
# for registration to work without email. Set to "false" (or remove) for
# production so real confirmation/reset emails go out again.
AUTH_TEST_MODE=false

# Server-only secrets used to fetch + cache recipe photos (see
# src/lib/images/*). Never prefix with NEXT_PUBLIC_. OPENAI_API_KEY (paid,
# AI-generated, most consistent) is preferred when set; otherwise
# PEXELS_API_KEY (free stock photos) is used.
OPENAI_API_KEY=
PEXELS_API_KEY=

# Server-only Supabase secret (Project Settings -> API -> service_role).
# Bypasses Row Level Security — only used server-side to write recipe
# images to Storage/DB, which regular user sessions are not allowed to
# do. Never prefix with NEXT_PUBLIC_, never expose to client code.
SUPABASE_SERVICE_ROLE_KEY=
